# Port overrides for dependency containers (`docker-compose.yml`, included by `docker-compose.full.yml`).
# Copy to `.env.deps` if you want non-default host ports.
#
#   cp .env.deps.example .env.deps
#
# Full stack on a VPS: pass **both** this file and `.env.docker` to Compose (see header in `docker-compose.full.yml`).

# MongoDB
MONGO_INITDB_DATABASE=novu-db
DOCKER_MONGO_PORT=27017

# Redis
DOCKER_REDIS_PORT=6379

# LocalStack (S3)
DOCKER_LOCALSTACK_PORT=4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ClickHouse
DOCKER_CLICKHOUSE_HTTP_PORT=8123
DOCKER_CLICKHOUSE_NATIVE_PORT=9000


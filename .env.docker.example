# Runtime env for Novu app containers (`docker-compose.full.yml`: api, worker, ws, dashboard).
# Copy to `.env.docker` and set secrets, then pass it to Compose alongside `.env.deps`:
#
#   cp .env.docker.example .env.docker
#   docker compose -f docker-compose.full.yml --env-file .env.deps --env-file .env.docker up -d --build
#
# --- VPS / public host ---
# Browsers use `VITE_*` URLs; the API uses `API_ROOT_URL` / `FRONT_BASE_URL` / `DASHBOARD_URL`.
# Replace `https://novu.example.com` (and WebSocket URL) with your real scheme, host, and ports.
#
#   API_ROOT_URL=https://novu.example.com
#   FRONT_BASE_URL=https://novu.example.com
#   DASHBOARD_URL=https://novu.example.com
#   VITE_API_HOSTNAME=https://novu.example.com
#   VITE_WEBSOCKET_HOSTNAME=wss://novu.example.com   # or https://… if you terminate WS on same host
#   VITE_DASHBOARD_URL=https://novu.example.com

JWT_SECRET=change-me-in-production
# Must be exactly 32 characters
STORE_ENCRYPTION_KEY=12345678901234567890123456789012

NODE_ENV=production
NOVU_ENTERPRISE=false

# In-cluster service URLs (Docker Compose DNS names)
MONGO_URL=mongodb://mongo:27017/novu-db
MONGO_MAX_POOL_SIZE=500

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB_INDEX=2

REDIS_CACHE_SERVICE_HOST=redis
REDIS_CACHE_SERVICE_PORT=6379

S3_LOCAL_STACK=http://localstack:4566
S3_BUCKET_NAME=novu-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

CLICK_HOUSE_URL=http://clickhouse:8123
CLICK_HOUSE_USER=default
CLICK_HOUSE_PASSWORD=
CLICK_HOUSE_DATABASE=novu-local

# Public URLs (browser / external callers — host ports from compose)
API_ROOT_URL=http://localhost:3000
API_INTERNAL_ORIGIN=http://api:3000
FRONT_BASE_URL=http://localhost:4201
DASHBOARD_URL=http://localhost:4201

# Prebuilt dashboard (GHCR) — browser must reach API/WS on the host (use your VPS IP or domain)
VITE_API_HOSTNAME=http://localhost:3000
VITE_WEBSOCKET_HOSTNAME=http://localhost:3002
# Optional: pin prebuilt images (api/worker/ws are still built locally)
# NOVU_IMAGE_TAG=3.14.0

DISABLE_USER_REGISTRATION=false
NEW_RELIC_ENABLED=false
LOG_LEVEL=info

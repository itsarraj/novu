# Only for dependency containers started by `docker compose`.
# Copy to `.env.deps` if you want to override defaults.
#
#   cp .env.deps.example .env.deps

# MongoDB
MONGO_INITDB_DATABASE=novu-db
DOCKER_MONGO_PORT=27017

# Redis
DOCKER_REDIS_PORT=6379

# LocalStack (S3)
DOCKER_LOCALSTACK_PORT=4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ClickHouse
DOCKER_CLICKHOUSE_HTTP_PORT=8123
DOCKER_CLICKHOUSE_NATIVE_PORT=9000

# ~8GB RAM tuning (optional overrides for docker-compose.yml + docker-compose.full.yml)
# MONGO_MEM_LIMIT=900m
# MONGO_WIRED_TIGER_CACHE_GB=0.35
# REDIS_MEM_LIMIT=200m
# REDIS_MAXMEMORY=128mb
# LOCALSTACK_MEM_LIMIT=512m
# CLICKHOUSE_MEM_LIMIT=768m
# API_MEM_LIMIT=900m
# WORKER_MEM_LIMIT=1024m
# WS_MEM_LIMIT=400m
# DASHBOARD_MEM_LIMIT=256m
# API_NODE_OPTIONS=--max-old-space-size=384
# WORKER_NODE_OPTIONS=--max-old-space-size=384
# WS_NODE_OPTIONS=--max-old-space-size=256


FROM node:22.22.1-alpine3.22 AS builder
RUN apk add g++ make py3-pip
ENV NX_DAEMON=false

WORKDIR /usr/src/app

RUN apk add --no-cache bash
RUN npm install -g pnpm@10.33.0 --loglevel notice

COPY .npmrc .
COPY package.json .

COPY apps/dashboard ./apps/dashboard
COPY libs ./libs
COPY packages ./packages
COPY enterprise ./enterprise
COPY tsconfig.json .

COPY nx.json .
COPY pnpm-workspace.yaml .
COPY pnpm-lock.yaml .

# Browser-visible URLs (override via `docker compose build --build-arg` / compose `args`)
ARG VITE_API_HOSTNAME=http://localhost:3000
ARG VITE_WEBSOCKET_HOSTNAME=http://localhost:3002
ARG VITE_DASHBOARD_URL=http://localhost:4201
ARG VITE_SELF_HOSTED=true
ENV VITE_API_HOSTNAME=$VITE_API_HOSTNAME
ENV VITE_WEBSOCKET_HOSTNAME=$VITE_WEBSOCKET_HOSTNAME
ENV VITE_DASHBOARD_URL=$VITE_DASHBOARD_URL
ENV VITE_SELF_HOSTED=$VITE_SELF_HOSTED

RUN --mount=type=cache,id=pnpm-store-dashboard,target=/root/.pnpm-store\
  pnpm install --frozen-lockfile --unsafe-perm

# Build dashboard without Nx to avoid EE task-graph cycles on partial EE checkouts.
# Run the build steps directly so we can cap Node memory (the `build` script hardcodes 8GB).
RUN CI='' NODE_OPTIONS='--max-old-space-size=4096' pnpm --filter @novu/dashboard exec tsc -b && \
    CI='' NODE_OPTIONS='--max-old-space-size=4096' pnpm --filter @novu/dashboard exec vite build

FROM node:22.22.1-alpine3.22

RUN npm install -g http-server --loglevel notice

USER 1000
WORKDIR /app

COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/dist /app/dist
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/package.json /app/package.json
COPY --chown=1000:1000 --from=builder /usr/src/app/apps/dashboard/docker-entrypoint.sh /app/docker-entrypoint.sh  

RUN chmod +x /app/docker-entrypoint.sh
ENTRYPOINT [ "/app/docker-entrypoint.sh" ]
# Expose the port the app runs on
EXPOSE 4000
CMD [ "http-server", "dist", "-p", "4000", "-d", "false", "--proxy", "http://localhost:4000?" ]